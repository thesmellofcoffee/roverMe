#include <ESP8266WiFi.h>
#include <WiFiClientSecure.h>

const char* ssid = "YOUR_SSID_HERE";
const char* password = "YOUR_WIFI_PASSWORD_HERE";
const char* firebaseHost = "your-firebase-project.firebaseio.com";

WiFiClientSecure client;

float targetLat = 0.0;
float targetLon = 0.0;
String targetCompass = "";

void setup() {
  Serial.begin(9600);
  WiFi.begin(ssid, password);
  
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
  }
  client.setInsecure();

  updateIsReady(false);
  updateIsReady(true);
  delay(3000);
  String checkpointData = getNextCheckpointFromFirebase();
  updateIsReady(false);
  parseAndPrintCheckpointData(checkpointData);
}

void loop() {
  if (Serial.available()) {
    String command = Serial.readStringUntil('\n');
    command.trim();
    
    if (command == "next") {
      handleCheckpointSequence();
    }
    else if (command == "again") {
      sendLastCheckpointData();
    }
    else if (command == "get data") {
      getDataFromFirebase();
    } 
    else if (command.startsWith("send data")) {
      sendDataToFirebase(command);
    }
    else if (command == "get command") {
      getCommandFromFirebase();
    }
  }
}

void handleCheckpointSequence() {
  updateIsReady(true);
  delay(3000);
  String checkpointData = getNextCheckpointFromFirebase();
  updateIsReady(false);
  parseAndPrintCheckpointData(checkpointData);
}

String getNextCheckpointFromFirebase() {
  String url = "/user/command/nextCheckpoint.json";
  client.connect(firebaseHost, 443);
  client.print(String("GET ") + url + " HTTP/1.1\r\n" +
               "Host: " + firebaseHost + "\r\n" +
               "Connection: close\r\n\r\n");
               
  String response = "";
  while (client.connected() || client.available()) {
    if (client.available()) {
      response += client.readString();
    }
  }
  client.stop();
  
  int jsonStart = response.indexOf("\r\n\r\n");
  if (jsonStart != -1) {
    response = response.substring(jsonStart + 4);
  }
  response.trim();
  return response;
}

void parseAndPrintCheckpointData(String checkpointData) {
  Serial.println("Raw JSON Data:");
  Serial.println(checkpointData);

  int latIndex     = checkpointData.indexOf("\"lat\":");
  int lonIndex     = checkpointData.indexOf("\"lon\":");
  int compassIndex = checkpointData.indexOf("\"compass\":");

  if (latIndex != -1 && lonIndex != -1 && compassIndex != -1) {
    int latStart = checkpointData.indexOf("\"", latIndex + 6) + 1;
    int latEnd   = checkpointData.indexOf("\"", latStart);
    String latValue = checkpointData.substring(latStart, latEnd);

    int lonStart = checkpointData.indexOf("\"", lonIndex + 6) + 1;
    int lonEnd   = checkpointData.indexOf("\"", lonStart);
    String lonValue = checkpointData.substring(lonStart, lonEnd);

    int compStart = checkpointData.indexOf("\"", compassIndex + 10) + 1;
    int compEnd   = checkpointData.indexOf("\"", compStart);
    String compassValue = checkpointData.substring(compStart, compEnd);

    targetLat = latValue.toFloat();
    targetLon = lonValue.toFloat();
    targetCompass = compassValue;
    
    Serial.println("Checkpoint Data:");
    Serial.println("Latitude: " + latValue);
    Serial.println("Longitude: " + lonValue);
    Serial.println("Compass: " + compassValue);
  } else {
    Serial.println("Veriler alınamadı!");
  }
}

void sendLastCheckpointData() {
  String data = "{\"compass\":\"" + targetCompass + "\",\"lat\":\"" 
                + String(targetLat, 6) + "\",\"lon\":\"" 
                + String(targetLon, 6) + "\"}";
  Serial.println("Son checkpoint verisi tekrar gönderiliyor:");
  Serial.println(data);
}

void getDataFromFirebase() {
  String url = "/user/location.json";
  client.connect(firebaseHost, 443);
  client.print(String("GET ") + url + " HTTP/1.1\r\n" +
               "Host: " + firebaseHost + "\r\n" +
               "Connection: close\r\n\r\n");

  String response = "";
  while (client.connected() || client.available()) {
    if (client.available()) {
      response += client.readString();
    }
  }
  client.stop();

  int latIndex = response.indexOf("\"lat\":");
  int lonIndex = response.indexOf("\"lon\":");
  if (latIndex != -1 && lonIndex != -1) {
    String latValue = response.substring(latIndex + 6, response.indexOf(",", latIndex));
    String lonValue = response.substring(lonIndex + 6, response.indexOf("}", lonIndex));
    String result = "{" + latValue + ", " + lonValue + "}";
    Serial.println(result);
  } else {
    Serial.println("Veri alınamadı!");
  }
}

void getCommandFromFirebase() {
  String url = "/user/command/activeCommand.json";
  client.connect(firebaseHost, 443);
  client.print(String("GET ") + url + " HTTP/1.1\r\n" +
               "Host: " + firebaseHost + "\r\n" +
               "Connection: close\r\n\r\n");

  String response = "";
  while (client.connected() || client.available()) {
    if (client.available()) {
      response += client.readString();
    }
  }
  client.stop();

  int commandStart = response.indexOf("\"") + 1;
  int commandEnd = response.lastIndexOf("\"");
  if (commandStart != -1 && commandEnd != -1 && commandEnd > commandStart) {
    String command = response.substring(commandStart, commandEnd);
    command.trim();
    if (command == "forward" || command == "backward" || 
        command == "left" || command == "right" || command == "" || command == "gpsStatus") {
      Serial.println(command);
    } else {
      Serial.println("HATA: Geçersiz komut");
    }
  } else {
    Serial.println("HATA");
  }
}

void updateIsReady(bool ready) {
  String url = "/rover/isReady.json";
  String data = ready ? "true" : "false";

  client.connect(firebaseHost, 443);
  client.print(String("PUT ") + url + " HTTP/1.1\r\n" +
               "Host: " + firebaseHost + "\r\n" +
               "Content-Type: application/json\r\n" +
               "Content-Length: " + String(data.length()) + "\r\n" +
               "Connection: close\r\n\r\n" +
               data);

  while (client.connected() || client.available()) {
    if (client.available()) {
      client.readString();
    }
  }
  client.stop();
}

void sendDataToFirebase(String command) {
  int firstSpace = command.indexOf(' ') + 1;
  int secondSpace = command.indexOf(' ', firstSpace + 1);
  int thirdSpace = command.indexOf(' ', secondSpace + 1);

  if (firstSpace == -1 || secondSpace == -1 || thirdSpace == -1) {
    Serial.println("HATA: Eksik parametre");
    return;
  }

  String lat = command.substring(secondSpace + 1, thirdSpace);
  String lon = command.substring(thirdSpace + 1);

  String url = "/rover/location.json";
  client.connect(firebaseHost, 443);
  String data = "{\"lat\": \"" + lat + "\", \"lon\": \"" + lon + "\"}";
  client.print(String("PUT ") + url + " HTTP/1.1\r\n" +
               "Host: " + firebaseHost + "\r\n" +
               "Content-Type: application/json\r\n" +
               "Content-Length: " + String(data.length()) + "\r\n" +
               "Connection: close\r\n\r\n" +
               data);

  String response = "";
  while (client.connected() || client.available()) {
    if (client.available()) {
      response += client.readString();
    }
  }
  client.stop();
}
